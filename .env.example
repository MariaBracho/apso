# Copiar a .env.local y rellenar.
#
# En desarrollo, `supabase start` imprime estos valores. En producción salen
# del panel del proyecto en Supabase.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Salta RLS. Nunca con prefijo NEXT_PUBLIC_ y nunca en el repo.
SUPABASE_SECRET_KEY=

# Google OAuth para "Entrar con Google".
# Google Cloud Console → Credenciales → ID de cliente de OAuth (Aplicación web),
# con http://127.0.0.1:54321/auth/v1/callback como URI de redireccionamiento.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Aviso por correo de cada pedido nuevo (resend.com).
# Sin esto la tienda funciona igual: el pedido se registra y solo queda anotado
# en el log que no se avisó.
RESEND_API_KEY=

# Mientras el dominio no esté verificado en Resend, su remitente de pruebas
# SOLO entrega al correo con el que se registró la cuenta de Resend; a
# cualquier otro devuelve 403.
#   CORREO_REMITENTE=apso <onboarding@resend.dev>
# Con apso.store verificado en Resend, ya entrega a quien sea:
#   CORREO_REMITENTE=apso <pedidos@apso.store>
CORREO_REMITENTE=

# A quién le llega el aviso. Varios, separados por coma.
# Antes de verificar el dominio tiene que ser el correo dueño de la cuenta de
# Resend, o el envío da 403.
CORREO_PEDIDOS=josephbrachovillanueva2@gmail.com

# Para armar el enlace al pedido dentro del correo.
NEXT_PUBLIC_SITIO=https://apso.store
